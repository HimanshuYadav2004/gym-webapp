generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GymOwner {
  id           String    @id @default(uuid())
  email        String    @unique
  password     String
  fullName     String
  phoneNumber  String
  gymName      String
  gymAddress   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  isSuperAdmin     Boolean   @default(false)
  licenseStatus    String    @default("trial") // trial, active, expired, suspended
  licensePlan      String    @default("Monthly")
  licenseAmount    Decimal   @default(999) @db.Decimal(10, 2)
  licenseExpiresAt DateTime?

  // Geofenced check-in — null lat/lng means the gym hasn't set a location
  // yet, in which case check-in stays location-unrestricted (opt-in, so
  // existing gyms aren't broken by this).
  gymLatitude         Float?
  gymLongitude        Float?
  checkinRadiusMeters Int    @default(150)

  members         Member[]
  licensePayments LicensePayment[]

  @@map("gym_owners")
}

model LicensePayment {
  id         String   @id @default(uuid())
  amount     Decimal  @db.Decimal(10, 2)
  periodDays Int      @default(30)
  status     String   @default("paid") // created, paid, failed — "created" until Razorpay confirms
  method     String   @default("admin_grant") // razorpay, admin_grant
  createdAt  DateTime @default(now())
  paidAt     DateTime?

  razorpayOrderId   String? @unique
  razorpayPaymentId String?

  gymOwnerId String
  gymOwner   GymOwner @relation(fields: [gymOwnerId], references: [id], onDelete: Cascade)

  @@map("license_payments")
  @@index([gymOwnerId])
  @@index([razorpayOrderId])
}

model AuditLog {
  id           String   @id @default(uuid())
  action       String   // e.g. "license.extend", "license.suspend", "license.activate"
  targetGymId  String?
  targetGymName String?
  actorEmail   String
  details      String?
  createdAt    DateTime @default(now())

  @@map("audit_logs")
  @@index([createdAt])
}

model Member {
  id              String    @id @default(uuid())
  membershipId    String    @unique
  fullName        String
  email           String?
  phoneNumber     String
  photoUrl        String?
  dateOfBirth     DateTime?
  gender          String?
  address         String?
  emergencyContact String?
  joiningDate     DateTime  @default(now())
  isActive        Boolean   @default(true)
  
  gymOwnerId      String
  gymOwner        GymOwner  @relation(fields: [gymOwnerId], references: [id], onDelete: Cascade)
  
  memberships     Membership[]
  payments        Payment[]
  attendance      Attendance[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@map("members")
  @@index([gymOwnerId])
}

model Membership {
  id              String    @id @default(uuid())
  planName        String    // e.g., "Monthly", "Quarterly", "Yearly"
  planDuration    Int       // Duration in days
  planAmount      Decimal   @db.Decimal(10, 2)
  startDate       DateTime
  endDate         DateTime
  status          String    @default("active") // active, expired, cancelled
  
  memberId        String
  member          Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@map("memberships")
  @@index([memberId])
  @@index([status])
  @@index([endDate])
}

model Payment {
  id              String    @id @default(uuid())
  amount          Decimal   @db.Decimal(10, 2)
  paymentDate     DateTime  @default(now())
  paymentMethod   String    // cash, card, upi, online
  remarks         String?
  
  memberId        String
  member          Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime  @default(now())
  
  @@map("payments")
  @@index([memberId])
  @@index([paymentDate])
}

model Attendance {
  id              String    @id @default(uuid())
  checkInTime     DateTime  @default(now())
  checkOutTime    DateTime?
  
  memberId        String
  member          Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  
  @@map("attendance")
  @@index([memberId])
  @@index([checkInTime])
}
